@startuml CUN_Paquete_Entrega_LogisticaInversa
!theme plain
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam actor {
    BackgroundColor<<Business Actor>> #E3F2FD
    BorderColor<<Business Actor>> #1976D2
    FontColor<<Business Actor>> #0D47A1
    
    BackgroundColor<<Business Worker>> #FFF3E0
    BorderColor<<Business Worker>> #F57C00
    FontColor<<Business Worker>> #E65100
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #424242
    ArrowColor #37474F
    FontColor #212121
}

left to right direction

header Yanbal Perú - Etapas de Entrega en Sede y Logística Inversa
title Casos de Uso del Negocio: Entrega en Sede y Contingencias (CUN-03 y CUN-04)

actor "Socio Logístico / Transportista\n(Proveedor en Campo)" as ActorSocio <<Business Actor>>
actor "Consultora / Distribuidor\n(Destinatario de Carga)" as ActorConsultora <<Business Actor>>
actor "Personal Autorizado\n(Recepción en Sede / Agencia)" as ActorPersonaAutorizada <<Business Actor>>

rectangle "Frontera de Entrega y Excepciones en Destino" {
    usecase "CUN-03: Entregar Carga en Sede\nAutorizada de Destino" as CUN03
    usecase "CUN-04: Gestionar Rechazo o Retorno\npor Logística Inversa" as CUN04
}

ActorSocio -- CUN03
ActorConsultora -- CUN03
ActorPersonaAutorizada -- CUN03

ActorSocio -- CUN04

@enduml
