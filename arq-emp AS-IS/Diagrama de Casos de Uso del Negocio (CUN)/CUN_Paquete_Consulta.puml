@startuml CUN_Paquete_Consulta
!theme plain
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam actor {
    BackgroundColor<<Business Actor>> #E3F2FD
    BorderColor<<Business Actor>> #1976D2
    FontColor<<Business Actor>> #0D47A1
    
    BackgroundColor<<Business Worker>> #FFF3E0
    BorderColor<<Business Worker>> #F57C00
    FontColor<<Business Worker>> #E65100
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #424242
    ArrowColor #37474F
    FontColor #212121
}

left to right direction

header Yanbal Perú - Etapa de Consulta y Seguimiento de Trazabilidad
title Caso de Uso del Negocio: Consulta de Trazabilidad y Estado de Despacho (CUN-05)

actor "Consultora / Distribuidor\n(Destinatario de Carga)" as ActorConsultora <<Business Actor>>
actor "Agente de Servicio al Cliente\n(Atención en Salesforce)" as WorkerAgente <<Business Worker>>

rectangle "Frontera de Consulta de Trazabilidad" {
    usecase "CUN-05: Consultar Trazabilidad\ny Estado de Despacho" as CUN05
}

ActorConsultora -- CUN05
WorkerAgente -- CUN05

@enduml
