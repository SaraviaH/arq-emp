@startuml DIAG-07_2_Despliegue_Nube_Corporativa_Cluster_MTD_y_Apps
' ============================================================================
' ID Diagrama Derivado: DIAG-07.2
' Nombre: Despliegue Tecnológico TO-BE (Parte 2): Nube Corporativa Yanbal (Node_Cloud), Clúster MTD, Middleware y Aplicaciones Corporativas
' Tipo de Diagrama UML: Diagrama de Despliegue (OMG UML 2.5.1 — Deployment Diagram | Categoría: Estructural)
' Diagrama General del que Procede: DIAG-07 — Diagrama UML de Despliegue de la Arquitectura Tecnológica Objetivo (TO-BE)
' Archivo Original de Origen: 05_Fase_D_Arquitectura_Tecnologica/diagramas/DIAG-07_Despliegue_Arquitectura_Tecnologica_TO_BE.puml
' ============================================================================

skinparam shadowing false
skinparam roundcorner 8
skinparam node {
    BackgroundColor #F8F9FA
    BorderColor #2B2D42
    FontColor #1D2A44
    FontStyle bold
}
skinparam artifact {
    BackgroundColor #EDF2F4
    BorderColor #8D99AE
    FontColor #2B2D42
    FontSize 11
}
skinparam database {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #174EA6
    FontStyle bold
}

title DIAG-07.2 — Diagrama UML de Despliegue TO-BE (Parte 2): Nube Corporativa Yanbal, Clúster MTD, Middleware y Aplicaciones\n[Derivado de DIAG-07 | Tipo UML: Despliegue | Fase D — Apartado 5.6 | Plataforma de Integración y Servicios MTD]

' ============================================================================
' NODO 2: NUBE CORPORATIVA / DATA CENTER INTEGRACIÓN Y SERVICIOS MTD
' ============================================================================
node "<<cloud: hybrid / enterprise>>\nNube Corporativa Yanbal - Plataforma de Integración y MTD\n[TI y Arquitectura: ACT-12 | Seguridad: ACT-11]" as Node_Cloud {
    
    node "<<dmz: security>>\nPerímetro Seguro de Ingesta y API Gateway" as Node_DMZ {
        artifact "<<gateway: proposed>>\nAPI Gateway Corporativo\n[Terminación TLS 1.3 | WAF | Rate Limiting]\n[Autenticación mTLS / OAuth 2.0 Token Check]" as Art_APIGW
    }
    
    node "<<cluster: integration>>\nMiddleware Corporativo de Mensajería" as Node_Middleware {
        artifact "<<middleware: SoR>>\nSIS-05: Bus de Integración Corporativo\n[Tópicos Pub/Sub de Eventos de Despacho B2B]\n[Colas dedicadas y Dead Letter Queue (DLQ)]" as Art_Bus
    }
    
    node "<<cluster: compute>>\nClúster de Microservicios / Componentes MTD\n[Capacidad Lógica de Integración Propuesta (DEC-02)]" as Node_MTD {
        artifact "<<service: proposed>>\nCMP-ING-01: Ingesta y Normalización\n[Idempotencia SHA-256 | Filtro Duplicados]" as Art_ING01
        artifact "<<mediator: proposed>>\nCMP-COR-02: Correlación Lógica\n[Enlace Código UA - Picking - Número Pedido]" as Art_COR02
        artifact "<<rule-engine: proposed>>\nCMP-VAL-03: Validación Semántica\n[Secuencia de 5 Estados Canónicos]" as Art_VAL03
        artifact "<<telemetry: proposed>>\nCMP-AUD-04: Auditoría y SLA\n[Sello T1 | Medición Delta T = T1 - T0 <= 30 min]" as Art_AUD04
        artifact "<<dispatcher: proposed>>\nCMP-PUB-05: Publicación Desacoplada\n[Difusión de Estados Consolidados]" as Art_PUB05
        artifact "<<event-handler: proposed>>\nCMP-NOT-06: Gestión de Incidencias\n[Notificación Retorno a ACT-03 (Sin tocar SAP)]" as Art_NOT06
    }
    
    database "<<storage: high-availability>>\nPersistencia de Trazabilidad Canónica" as DB_MTD {
        artifact "<<event-store: proposed>>\nRepositorio de Eventos Inmutables (ENT-07)\n[Partición Operativa < 90 días Hot Data]\n[Partición Histórica 5 años Cold Archive]" as Art_EventStore
    }
    
    node "<<server: enterprise-apps>>\nServidores de Aplicaciones Corporativas Yanbal" as Node_CorpApps {
        artifact "<<system: SoR>>\nSIS-03: Maya (Portal Comercial)\n[Ingreso de Pedidos Consultoras/Directoras]" as Art_Maya
        artifact "<<system: SoR>>\nSIS-04: ZapCommerce\n[Motor Transaccional Pedidos (ASM-08)]" as Art_Zap
        artifact "<<system: SoR>>\nSIS-07: ENSDY\n[Sistema de Trackeo y Seguimiento (ASM-02)]" as Art_ENSDY
        artifact "<<system: SoR>>\nSIS-09: CELLFORCE\n[CRM Atención Consultas y Reclamos (ASM-06)]" as Art_CRM
        artifact "<<adapter: proposed>>\nADP-CRM: Conector de Eventos CRM" as Art_ADPCRM
    }
}

' Comunicaciones en Nube Corporativa
Art_APIGW --> Art_ING01 : Enrutamiento Interno (HTTP/2 / gRPC)\n[Evento normalizado con T0 y firma hash]
Art_ING01 --> Art_AUD04 : In-Process Call\n[Estampado T1 y cálculo Delta T = T1 - T0]
Art_ING01 --> Art_VAL03 : Cola Asíncrona Interna (AMQP)\n[Validación semántica y de secuencia]
Art_VAL03 --> Art_COR02 : Llamada Interna / Caché Memoria\n[Correlación Pedido - Bulto - UA]
Art_VAL03 --> DB_MTD : Pool JDBC Cifrado (TLS 1.3)\n[Persistencia inmutable ENT-07]
Art_VAL03 --> Art_PUB05 : Event Dispatcher\n[Evento canónico validado]
Art_PUB05 --> Art_Bus : AMQP / Pub-Sub (TLS 1.3)\n[Publicación en tópico de eventos consolidados]

' Flujo hacia aplicaciones corporativas
Art_Bus --> Art_ENSDY : Suscriptor de Tópico (Pub/Sub)\n[Actualización de estatus de trackeo]
Art_Bus --> Art_ADPCRM : Suscriptor de Tópico (Pub/Sub)\n[Notificación para actualizar CELLFORCE]
Art_ADPCRM --> Art_CRM : HTTPS REST API (TLS 1.3)\n[Disponibilidad de estado en <= 30 min (REQ-NEG-003)]
Art_Maya --> Art_Zap : Integración Interna Comercial\n[Estado 1: Pedido facturado]
Art_Zap --> Art_Bus : HTTPS REST / AMQP\n[Publicación de orden aprobada]

' Flujo de Notificación de Retornos (Logística Inversa)
Art_VAL03 ..> Art_NOT06 : Canal de Excepciones\n[Incidencia en ruta / Retorno iniciado]
Art_NOT06 --> Art_Bus : Mensaje Asíncrono de Alerta\n[Canal exclusivo de Almacén Lurín]

@enduml

